# ── Variables de entorno — Backend Nexus ─────────────────────────────────────
# Renombrar este archivo a .env y rellenar los valores reales
# NUNCA subir el .env real a GitHub

# MongoDB Atlas
MONGODB_USER=tu_usuario_atlas
MONGODB_PASSWORD=tu_password_atlas
MONGODB_SERVER=cluster0.xxxxx.mongodb.net

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Servidor
PORT=3001

# CORS — en producción poner la IP pública del EC2 del frontend
ALLOWED_ORIGIN=http://localhost:3000
